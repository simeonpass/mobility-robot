{%- comment -%} Generated from the Hydrogen site's "Book a demo" page. Edit the text here in the code editor. {%- endcomment -%}
<div class="xsto-container py-8 md:py-12 "><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://mobilityrobot.co.uk"},{"@type":"ListItem","position":2,"name":"Book a Demo"}]}</script><section class="overflow-hidden rounded-2xl border border-border bg-gradient-navy text-white"><div class="px-5 py-8 sm:px-8 md:px-10 md:py-12"><p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-white/70">In-person demonstration</p><h1 class="max-w-2xl font-display text-3xl font-bold tracking-tight text-white md:text-4xl">Book a demo</h1><p class="mt-3 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">See and try an XSTO wheelchair before you buy — at a location in Dorset or London. No obligation.</p><div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-white/75"><a class="underline-offset-2 hover:text-white hover:underline" href="#demo-form">Request a booking</a><a href="/pages/stockists" class="underline-offset-2 hover:text-white hover:underline">Find a stockist</a><a href="/pages/vat-relief" class="underline-offset-2 hover:text-white hover:underline">VAT relief</a></div></div></section><nav aria-label="Breadcrumb" class="mt-5 text-xs text-muted-foreground"><ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="hover:text-gold">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" class="font-medium text-foreground">Book a Demo</li></ol></nav><div class="mt-8 grid gap-10 lg:grid-cols-5 lg:gap-12 lg:items-start"><section aria-labelledby="demo-form-heading" class="lg:col-span-3" id="demo-form"><h2 class="font-display text-2xl font-bold tracking-tight text-foreground" id="demo-form-heading">Request your demo</h2><p class="mt-2 max-w-xl text-muted-foreground">Tell us how to reach you and which model you&#x27;d like to try. Your postcode helps us match you with the best location.</p>{% form 'contact', class: 'mt-8 space-y-6', id: 'mr-form-demo-request' %}<input type="hidden" name="contact[Enquiry type]" value="Demo request">{%- if form.posted_successfully? -%}<p class="rounded-lg border px-4 py-3 text-sm border-border bg-secondary/40 text-foreground" role="status">Thank you. We have your request and will confirm within one business day.</p>{%- endif -%}{%- if form.errors -%}<div class="rounded-lg border px-4 py-3 text-sm border-destructive/40 text-destructive" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<fieldset class="space-y-4"><legend class="mb-1 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Your details</legend><div class="grid gap-4 sm:grid-cols-2"><label class="block text-sm" for="name"><span class="mb-1.5 block text-sm font-medium text-foreground">Full name</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" autoComplete="name" id="name" required="" type="text" name="contact[name]"/></label><label class="block text-sm" for="phone"><span class="mb-1.5 block text-sm font-medium text-foreground">Phone</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" autoComplete="tel" id="phone" required="" type="tel" name="contact[phone]"/></label><label class="block text-sm" for="email"><span class="mb-1.5 block text-sm font-medium text-foreground">Email</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" autoComplete="email" id="email" required="" type="email" name="contact[email]"/></label><label class="block text-sm" for="postcode"><span class="mb-1.5 block text-sm font-medium text-foreground">Postcode</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" autoComplete="postal-code" id="postcode" required="" type="text" name="contact[Postcode]"/></label></div></fieldset><fieldset class="space-y-4"><legend class="mb-1 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">Preferences</legend><label class="block text-sm" for="model"><span class="mb-1.5 block text-sm font-medium text-foreground">Preferred model</span><select class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="model" name="contact[Preferred model]" required=""><option disabled="" value="" selected="">Select a model</option><option value="M4">M4</option><option value="M4 Pro">M4 Pro</option><option value="M4B">M4B</option><option value="X12">X12</option><option value="X12 Pro">X12 Pro</option></select></label><div class="grid gap-4 sm:grid-cols-2"><label class="block text-sm" for="preferredDate"><span class="mb-1.5 block text-sm font-medium text-foreground">Preferred date (optional)</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="preferredDate" type="date" name="contact[Preferred date]"/></label><label class="block text-sm" for="preferredTime"><span class="mb-1.5 block text-sm font-medium text-foreground">Preferred time (optional)</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="preferredTime" placeholder="e.g. Morning" type="text" name="contact[Preferred time]"/></label></div><label class="block text-sm" for="notes"><span class="mb-1.5 block text-sm font-medium text-foreground">Anything else? (optional)</span><textarea class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm min-h-28" id="notes" name="contact[body]" placeholder="Accessibility needs, companion attending, questions about VAT relief…"></textarea></label></fieldset><div class="flex flex-col gap-3 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between"><p class="text-sm text-muted-foreground">We&#x27;ll confirm within one business day.</p><button class="btn-accent min-h-11 w-full sm:w-auto sm:min-w-[11rem] disabled:opacity-60" type="submit">Book your demo</button></div>{% endform %}</section><div class="space-y-8 lg:col-span-2 lg:sticky lg:top-28 lg:pt-1"><section aria-labelledby="demo-expect-heading"><h2 class="font-display text-xl font-bold tracking-tight text-foreground" id="demo-expect-heading">What happens next</h2><ol class="mt-6 space-y-6"><li class="flex gap-4"><span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-navy/5 text-navy"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square size-5" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" /></svg></span><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-gold">Step 1</p><p class="mt-1 font-semibold text-foreground">We confirm within one business day</p><p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">Our team will call or email to agree a date, time and location that works for you.</p></div></li><li class="flex gap-4"><span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-navy/5 text-navy"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /> <circle cx="12" cy="10" r="3" /></svg></span><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-gold">Step 2</p><p class="mt-1 font-semibold text-foreground">Dorset or London location</p><p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">We&#x27;ll arrange a hands-on session at one of our locations in Dorset or London.</p></div></li><li class="flex gap-4"><span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-navy/5 text-navy"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-check size-5" aria-hidden="true"><path d="M8 2v3" /> <path d="M16 2v3" /> <rect x="3" y="3" width="18" height="18" rx="2" /> <path d="M3 9h18" /> <path d="m9 15 2 2 4-4" /></svg></span><div><p class="text-xs font-semibold uppercase tracking-[0.12em] text-gold">Step 3</p><p class="mt-1 font-semibold text-foreground">Try before you buy</p><p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">Experience foldability, controls and fit — with guidance on sizing, accessories and VAT relief.</p></div></li></ol></section><section aria-labelledby="demo-vat-heading" class="border-y border-border py-6"><h2 class="font-semibold text-foreground" id="demo-vat-heading">VAT relief</h2><p class="mt-2 text-sm leading-relaxed text-muted-foreground">Eligible customers can buy qualifying XSTO powered wheelchairs VAT-free. Ask about eligibility during your demo, or <a href="/pages/vat-relief" class="font-medium text-navy underline-offset-2 hover:underline">read how VAT relief works</a>.</p></section><p class="text-sm text-muted-foreground">Prefer to speak to someone first? <a href="/pages/contact" class="font-medium text-navy underline-offset-2 hover:underline">Contact us</a>.</p></div></div></div>
