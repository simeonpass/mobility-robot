{%- comment -%} Generated from the Hydrogen site's "Request a quote" page. Edit the text here in the code editor. {%- endcomment -%}
<div class="xsto-container py-8 md:py-12 max-w-3xl"><header class="mb-8 max-w-3xl"><h1 class="text-3xl font-bold text-foreground md:text-4xl">Request a Quote</h1><p class="mt-3 text-lg text-muted-foreground">Healthcare professionals, care providers and retailers — request pricing for single or multiple units.</p></header><p class="mb-8 text-muted-foreground">A member of our team will respond within one business day with pricing, availability and delivery information tailored to your requirements.</p>{% form 'contact', class: 'space-y-4', id: 'mr-form-quote-request' %}<input type="hidden" name="contact[Enquiry type]" value="Quote request">{%- if form.posted_successfully? -%}<p class="rounded-lg border px-4 py-3 text-sm border-border bg-secondary/40 text-foreground" role="status">Thank you. We have your request and will send your quote shortly.</p>{%- endif -%}{%- if form.errors -%}<div class="rounded-lg border px-4 py-3 text-sm border-destructive/40 text-destructive" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}<label class="block text-sm" for="name"><span class="mb-1.5 block text-sm font-medium text-foreground">Name</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="name" required="" type="text" name="contact[name]"/></label><label class="block text-sm" for="email"><span class="mb-1.5 block text-sm font-medium text-foreground">Email</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="email" required="" type="email" name="contact[email]"/></label><label class="block text-sm" for="phone"><span class="mb-1.5 block text-sm font-medium text-foreground">Phone</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="phone" required="" type="tel" name="contact[phone]"/></label><label class="block text-sm" for="company"><span class="mb-1.5 block text-sm font-medium text-foreground">Company (optional)</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="company" type="text" name="contact[Company]"/></label><label class="block text-sm" for="model"><span class="mb-1.5 block text-sm font-medium text-foreground">Model</span><select class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="model" name="contact[Preferred model]" required=""><option disabled="" value="" selected="">Select a model</option><option value="M4">M4</option><option value="M4 Pro">M4 Pro</option><option value="M4B">M4B</option><option value="X12">X12</option><option value="X12 Pro">X12 Pro</option><option value="Multiple / Unsure">Multiple / Unsure</option></select></label><label class="block text-sm" for="quantity"><span class="mb-1.5 block text-sm font-medium text-foreground">Quantity</span><input class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="quantity" min="1" required="" type="number" name="contact[Quantity]" value="1"/></label><label class="block text-sm" for="vatReliefEligible"><span class="mb-1.5 block text-sm font-medium text-foreground">VAT relief eligible?</span><select class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm" id="vatReliefEligible" name="contact[VAT relief eligible]" required=""><option disabled="" value="" selected="">Select</option><option value="yes">Yes</option><option value="no">No</option></select></label><label class="block text-sm" for="notes"><span class="mb-1.5 block text-sm font-medium text-foreground">Notes (optional)</span><textarea class="w-full rounded-lg border border-border bg-background px-3.5 py-2.5 text-base text-foreground transition-colors placeholder:text-muted-foreground focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary sm:text-sm min-h-28" id="notes" name="contact[body]"></textarea></label><button class="btn-accent min-h-11 w-full sm:w-auto sm:min-w-[11rem] disabled:opacity-60" type="submit">Request quote</button>{% endform %}</div>
