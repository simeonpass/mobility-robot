true"><path d="M7 7h10v10" /> <path d="M7 17 17 7" /></svg></a><a href="/pages/guides" class="mr-discovery-link">Explore the buyer guides <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right" aria-hidden="true"><path d="M7 7h10v10" /> <path d="M7 17 17 7" /></svg></a></div></div>
