<div class="collections xsto-container py-8 md:py-12">
  <h1 class="text-3xl font-bold text-foreground md:text-4xl">Collections</h1>
  <p class="mt-3 max-w-2xl text-muted-foreground">Explore XSTO powered wheelchair and accessory collections.</p>
  <div>
    <div class="collections-grid mt-8">
      {%- for collection in collections -%}
        <a class="collection-item" href="{{ collection.url }}">
          {%- assign image = collection.image | default: collection.products.first.featured_image -%}
          {%- if image -%}
            <img alt="{{ image.alt | default: collection.title | escape }}" src="{{ image | image_url: width: 800 }}" style="width:100%;aspect-ratio:1/1" sizes="(min-width: 45em) 400px, 100vw" loading="lazy" decoding="async">
          {%- endif -%}
          <h2 class="mt-3 text-lg font-semibold text-foreground">{{ collection.title | escape }}</h2>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "MR collections list",
  "tag": "div",
  "class": "mr-contents"
}
{% endschema %}
