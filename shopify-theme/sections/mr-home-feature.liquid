<section class="mr-section mr-feature-section">
  <div class="xsto-container">
    <div class="mr-feature">
      <div class="mr-feature-image">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 840 }}" srcset="{{ section.settings.image | image_url: width: 480 }} 480w, {{ section.settings.image | image_url: width: 840 }} 840w, {{ section.settings.image | image_url: width: 1260 }} 1260w" sizes="(min-width: 1024px) 50vw, 100vw" alt="{{ section.settings.image_alt | escape }}" width="1600" height="840" loading="lazy" decoding="async">
        {%- else -%}
          <img src="{{ 'mr-about-hero-840.webp' | asset_url }}" srcset="{{ 'mr-about-hero-480.webp' | asset_url }} 480w, {{ 'mr-about-hero-840.webp' | asset_url }} 840w, {{ 'mr-about-hero-1260.webp' | asset_url }} 1260w" sizes="(min-width: 1024px) 50vw, 100vw" alt="{{ section.settings.image_alt | escape }}" width="1600" height="840" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
      <div class="mr-feature-copy">
        <p class="mr-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text_1 }}</p>
        {%- if section.settings.text_2 != blank -%}
          <p>{{ section.settings.text_2 }}</p>
        {%- endif -%}
        <a class="mr-button mr-button-amber" href="{{ section.settings.button_url }}">{{ section.settings.button_label }} {% render 'mr-icon', name: 'arrow-right', size: 18 %}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "MR image with text",
  "tag": "div",
  "class": "mr-contents",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the photo that ships with the theme." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Discover the XSTO powered wheelchair range with Bentech Medical" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Technology with a purpose" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the moments that matter." },
    { "type": "textarea", "id": "text_1", "label": "Paragraph 1", "default": "Meeting friends. Joining the conversation. Taking a different route. The right mobility technology should make more room for your life." },
    { "type": "textarea", "id": "text_2", "label": "Paragraph 2", "default": "Explore electric seat lifting, responsive self-levelling and the X12’s stair-climbing capability with someone who knows the range." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Experience it for yourself" },
    { "type": "text", "id": "button_url", "label": "Button URL", "default": "/demo" }
  ],
  "presets": [ { "name": "MR image with text" } ]
}
{% endschema %}
