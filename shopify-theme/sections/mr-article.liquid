<div class="xsto-container py-8 md:py-12 max-w-4xl">
  <article>
    <header class="mb-8">
      <p class="text-sm font-medium text-gold">XSTO News</p>
      <h1 class="mt-2 text-3xl font-bold text-foreground md:text-4xl">{{ article.title | escape }}</h1>
      <p class="mt-3 text-sm text-muted-foreground"><time datetime="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>{% if article.author != blank %} · <span>{{ article.author | escape }}</span>{% endif %}</p>
    </header>
    {%- if article.image -%}
      {%- render 'mr-image', image: article.image, alt: article.image.alt, class: 'mb-8 w-full rounded-xl', sizes: '(min-width: 768px) 800px, 100vw', loading: 'eager' -%}
    {%- endif -%}
    <div class="prose prose-neutral max-w-none text-foreground [&_a]:text-gold [&_img]:rounded-lg">{{ article.content }}</div>
  </article>
  {%- assign related_count = 0 -%}
  {%- capture related -%}
    {%- for other in blog.articles limit: 4 -%}
      {%- if other.id != article.id and related_count < 3 -%}
        {%- assign related_count = related_count | plus: 1 -%}
        <li><a class="block rounded-xl border border-border p-4 no-underline hover:border-gold" href="{{ other.url }}"><h3 class="text-sm font-semibold text-foreground">{{ other.title | escape }}</h3></a></li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if related_count > 0 -%}
    <section aria-labelledby="related-articles" class="mt-12 border-t border-border pt-10">
      <h2 class="text-xl font-semibold text-foreground" id="related-articles">Related articles</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">{{ related }}</ul>
    </section>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "MR article",
  "tag": "div",
  "class": "mr-contents"
}
{% endschema %}
