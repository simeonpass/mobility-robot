{%- comment -%}
  List price for a chair, as "inc|ex|compare_ex" in pence for the caller to split.
  - Product with a "VAT" option: the cheapest variant that is not "VAT Relief" is the
    VAT-inclusive price.
  - Otherwise the product's lowest price is read as the VAT-exclusive (VAT relief)
    price and 20% is added for the including-VAT figure. If the catalogue is ever
    switched to VAT-inclusive prices, set catalog_includes_vat to true below.
{%- endcomment -%}
{%- liquid
  assign catalog_includes_vat = false
  assign inc = 0
  assign ex = 0
  assign cmp_ex = 0
  if product.options contains 'VAT'
    assign cmp = 0
    for v in product.variants
      unless v.options contains 'VAT Relief'
        if inc == 0 or v.price < inc
          assign inc = v.price
          assign cmp = v.compare_at_price | default: 0
        endif
      endunless
    endfor
    assign ex = inc | divided_by: 1.2 | round
    if cmp > inc
      assign cmp_ex = cmp | divided_by: 1.2 | round
    endif
  endif
  if inc == 0
    assign cmp = product.compare_at_price_min | default: 0
    if catalog_includes_vat
      assign inc = product.price_min
      assign ex = inc | divided_by: 1.2 | round
      if cmp > inc
        assign cmp_ex = cmp | divided_by: 1.2 | round
      endif
    else
      assign ex = product.price_min
      assign inc = ex | times: 1.2 | round
      if cmp > ex
        assign cmp_ex = cmp
      endif
    endif
  endif
-%}
{{- inc }}|{{ ex }}|{{ cmp_ex -}}
