{%- comment -%} Wheelchair card on the shop-all page. Params: product, badge, name, delay (ms). {%- endcomment -%}
{%- liquid
  capture prices
    render 'mr-price', product: product
  endcapture
  assign parts = prices | strip | split: '|'
  assign ex = parts[1] | plus: 0
-%}
<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border/70 bg-card shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-medium animate-fade-in-up" style="animation-delay:{{ delay }}ms">
  <a class="relative flex h-full flex-col no-underline hover:no-underline" href="{{ product.url }}">
    <div class="absolute left-3 top-3 z-10 flex flex-wrap gap-1.5 sm:left-4 sm:top-4">
      <span class="rounded-full bg-background/95 px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-foreground shadow-soft backdrop-blur-sm sm:px-3 sm:text-xs">{{ badge }}</span>
    </div>
    <div class="flex aspect-[16/11] items-center justify-center bg-gradient-cream p-4 sm:aspect-[4/3] sm:p-6">
      {%- if product.featured_image -%}
        {%- render 'mr-image', image: product.featured_image, alt: product.featured_image.alt, class: 'max-h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]', sizes: '(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw' -%}
      {%- else -%}
        <span class="text-sm text-muted-foreground">No image</span>
      {%- endif -%}
    </div>
    <div class="flex flex-1 flex-col p-4 sm:p-5">
      <h3 class="text-base font-semibold text-foreground sm:text-lg">{{ name }}</h3>
      <p class="mt-1.5 text-lg font-semibold text-gold sm:mt-2 sm:text-xl">From {{ ex | money_without_trailing_zeros }}</p>
      <span class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-foreground transition-colors group-hover:text-gold sm:mt-5 sm:min-h-0">Explore {{ name }}{% render 'mr-icon', name: 'arrow-up-right', stroke: 1.75, class: 'size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5' %}</span>
    </div>
  </a>
</article>
