<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en-GB' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#233048">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preload" as="font" type="font/woff" href="{{ 'mr-dm-sans-latin.woff' | asset_url }}" crossorigin="anonymous">
    <link rel="preload" as="font" type="font/woff" href="{{ 'mr-manrope-latin.woff' | asset_url }}" crossorigin="anonymous">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'mr-favicon-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ 'mr-favicon-192.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'mr-apple-touch-icon.png' | asset_url }}">

    {%- liquid
      assign mr_title = page_title
      assign mr_description = page_description
      if template.name == 'index'
        assign mr_title = 'XSTO Powered Wheelchairs UK | Mobility Robot'
        assign mr_description = 'Explore the XSTO M4 and X12 series at Mobility Robot by Bentech Medical: self-levelling and stair-climbing powered wheelchairs with free UK delivery, VAT relief for eligible customers and UK support.'
      endif
    -%}
    <title>{{ mr_title }}</title>
    {%- if mr_description != blank -%}
      <meta name="description" content="{{ mr_description | escape }}">
    {%- endif -%}
    <meta property="og:site_name" content="Mobility Robot">
    <meta property="og:locale" content="en_GB">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ mr_title | escape }}">
    {%- if mr_description != blank -%}
      <meta property="og:description" content="{{ mr_description | escape }}">
    {%- endif -%}
    <meta property="og:image" content="https:{{ 'mr-og-default.jpg' | asset_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ mr_title | escape }}">
    <meta name="msvalidate.01" content="1784260E956C868F6D343DD3C472D30C">

    {{ 'mr-site.css' | asset_url | stylesheet_tag }}
    <style>
      .mr-contents { display: contents; }
    </style>

    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name }}">
    <div class="mr-shell flex min-h-screen flex-col">
      <a class="mr-skip-link" href="#main-content">Skip to content</a>
      {% section 'mr-announcement' %}
      {% section 'mr-header' %}
      <main class="flex-1" id="main-content" tabindex="-1">
        {%- if template.name == 'index' -%}
          <div class="mr-home">{{ content_for_layout }}</div>
        {%- else -%}
          {{ content_for_layout }}
        {%- endif -%}
      </main>
      {% section 'mr-footer' %}
    </div>
    <script src="{{ 'mr-site.js' | asset_url }}" defer></script>
  </body>
</html>
